---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Marquee from '../components/sections/Marquee.astro';
import About from '../components/sections/About.astro';
import Timeline from '../components/sections/Timeline.astro';
import Principles from '../components/sections/Principles.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import List from '../components/sections/List.astro';
import Contact from '../components/sections/Contact.astro';
import { anchor } from '../lib/text';

const [siteEntry] = await getCollection('sito');
const site = siteEntry.data;

const sections = (await getCollection('sezioni', (s) => s.data.enabled)).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('progetti', (p) => p.data.enabled)).sort((a, b) => a.data.order - b.data.order);

const navItems = sections
  .filter((s) => s.data.navLabel)
  .map((s) => ({ label: s.data.navLabel!, href: `#${anchor(s.id)}` }));

const contact = sections.find((s) => s.data.layout === 'contact');
const email = contact?.data.layout === 'contact' ? contact.data.email : '';

// numerazione "(01)" solo per le sezioni con un'etichetta
let counter = 0;
const numbered = sections.map((s) => ({ entry: s, index: s.data.kicker ? ++counter : 0 }));
---

<Base
  title={site.seoTitle}
  description={site.seoDescription}
  url={site.url}
  name={site.name}
  preloaderWords={site.preloaderWords}
>
  <Nav name={site.name} role={site.role} timezone={site.timezone} city={site.location} email={email} items={navItems} />
  <main id="main">
    {
      numbered.map(({ entry, index }) => {
        const id = anchor(entry.id);
        const d = entry.data;
        switch (d.layout) {
          case 'hero': return <Hero data={d} id={id} />;
          case 'marquee': return <Marquee data={d} id={id} />;
          case 'about': return <About entry={entry} data={d} id={id} index={index} />;
          case 'timeline': return <Timeline entry={entry} data={d} id={id} index={index} />;
          case 'principles': return <Principles entry={entry} data={d} id={id} index={index} />;
          case 'projects': return <Projects entry={entry} data={d} id={id} index={index} projects={projects} />;
          case 'skills': return <Skills data={d} id={id} index={index} />;
          case 'list': return <List data={d} id={id} index={index} />;
          case 'contact': return <Contact entry={entry} data={d} id={id} index={index} site={site} />;
        }
      })
    }
  </main>
</Base>
