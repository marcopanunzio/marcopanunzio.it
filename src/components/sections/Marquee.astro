---
import type { CollectionEntry } from 'astro:content';
type Data = Extract<CollectionEntry<'sezioni'>['data'], { layout: 'marquee' }>;
interface Props { data: Data; id: string }
const { data, id } = Astro.props;
const loop = [...data.items, ...data.items];
---

<section id={id} class="overflow-hidden border-y border-line py-6 md:py-9" data-marquee aria-label={data.items.join(', ')}>
  <div class="flex w-max will-change-transform" data-marquee-track aria-hidden="true">
    {
      [0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {loop.map((item, i) => (
            <span class="display flex items-center whitespace-nowrap text-[clamp(2.6rem,8vw,8rem)]">
              <span class:list={[i % 2 ? 'italic text-muted' : '']}>{item}</span>
              <span class="mx-[0.35em] inline-block h-[0.22em] w-[0.22em] rotate-45 bg-accent" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</section>
