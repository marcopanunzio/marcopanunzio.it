---
import type { CollectionEntry } from 'astro:content';
import SectionHead from '../SectionHead.astro';

type Data = Extract<CollectionEntry<'sezioni'>['data'], { layout: 'skills' }>;
interface Props { data: Data; id: string; index: number }
const { data, id, index } = Astro.props;
---

<section id={id} class="wrap py-28 md:py-44">
  <SectionHead index={index} kicker={data.kicker} title={data.title} />
  <div class="border-b border-line">
    {
      data.groups.map((g) => (
        <div class="group grid gap-4 border-t border-line py-8 md:grid-cols-12 md:py-10" data-reveal>
          <h3 class="display text-[clamp(1.7rem,2.8vw,2.6rem)] transition-colors duration-300 group-hover:text-accent md:col-span-4">
            {g.title}
          </h3>
          <ul class="flex flex-wrap gap-x-2 gap-y-2 md:col-span-8 md:pt-2">
            {g.items.map((it, i) => (
              <li class="text-lg text-muted transition-colors duration-300 group-hover:text-fg md:text-xl">
                {it}
                {i < g.items.length - 1 && <span class="ml-2 text-accent">/</span>}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
