---
import { render, type CollectionEntry } from 'astro:content';
import SectionHead from '../SectionHead.astro';

type Data = Extract<CollectionEntry<'sezioni'>['data'], { layout: 'timeline' }>;
interface Props { entry: CollectionEntry<'sezioni'>; data: Data; id: string; index: number }
const { entry, data, id, index } = Astro.props;
const { Content } = await render(entry);
---

<section id={id} class="wrap py-28 md:py-44">
  <SectionHead index={index} kicker={data.kicker} title={data.title} />

  <div class="grid gap-16 md:grid-cols-12">
    <ol class="relative md:col-span-7">
      <span class="absolute bottom-0 left-0 top-0 w-px bg-line" aria-hidden="true"></span>
      <span class="absolute bottom-0 left-0 top-0 w-px origin-top bg-accent" data-progress-line aria-hidden="true"></span>
      {
        data.items.map((item) => (
          <li class="group relative pb-16 pl-8 last:pb-0 md:pl-14" data-reveal>
            <span class="absolute -left-[5px] top-2 h-[11px] w-[11px] rotate-45 border border-accent bg-bg transition-colors group-hover:bg-accent" />
            <p class="label text-accent">{item.period}</p>
            <h3 class="display mt-3 text-[clamp(2rem,4.2vw,3.8rem)] transition-transform duration-500 ease-[cubic-bezier(.22,1,.36,1)] group-hover:translate-x-3">
              {item.role}
            </h3>
            <p class="label mt-3 text-fg">{item.company}</p>
            {item.note && <p class="mt-4 max-w-[52ch] text-muted">{item.note}</p>}
          </li>
        ))
      }
    </ol>

    <aside class="md:col-span-4 md:col-start-9">
      <div class="prose-site md:sticky md:top-28" data-reveal>
        <Content />
      </div>
    </aside>
  </div>
</section>
