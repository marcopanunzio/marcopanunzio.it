---
import type { CollectionEntry } from 'astro:content';
import SectionHead from '../SectionHead.astro';
import { pad } from '../../lib/text';

type Data = Extract<CollectionEntry<'sezioni'>['data'], { layout: 'list' }>;
interface Props { data: Data; id: string; index: number }
const { data, id, index } = Astro.props;
---

<section id={id} class="wrap py-28 md:py-44">
  <SectionHead index={index} kicker={data.kicker} title={data.title} />
  <ul class="border-b border-line">
    {
      data.items.map((item, i) => (
        <li class="group relative overflow-hidden border-t border-line" data-reveal>
          <span class="absolute inset-0 origin-bottom scale-y-0 bg-fg transition-transform duration-500 ease-[cubic-bezier(.22,1,.36,1)] group-hover:scale-y-100" aria-hidden="true" />
          <div class="relative grid gap-3 py-8 transition-[color,padding] duration-500 ease-[cubic-bezier(.22,1,.36,1)] group-hover:text-bg md:grid-cols-12 md:items-baseline md:py-11 md:group-hover:px-6">
            <span class="label text-muted group-hover:text-bg/60 md:col-span-1">{pad(i + 1)}</span>
            <h3 class="display text-[clamp(2.2rem,5vw,4.6rem)] transition-[font-style] md:col-span-5">{item.title}</h3>
            <p class="max-w-[46ch] text-muted group-hover:text-bg/80 md:col-span-4 md:text-lg">{item.text}</p>
            {item.tag && <span class="label text-accent md:col-span-2 md:text-right">{item.tag}</span>}
          </div>
        </li>
      ))
    }
  </ul>
</section>
