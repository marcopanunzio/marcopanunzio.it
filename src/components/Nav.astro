---
import Clock from './react/Clock';
import MobileMenu from './react/MobileMenu';

interface Props {
  name: string;
  role: string;
  timezone: string;
  city: string;
  email: string;
  items: { label: string; href: string }[];
}
const { name, role, timezone, city, email, items } = Astro.props;
---

<header data-nav class="wrap fixed inset-x-0 top-0 z-[70] py-5 text-white mix-blend-difference">
  <div class="flex items-center justify-between gap-6">
    <a href="#top" class="group flex items-baseline gap-3" aria-label={`${name}, torna all'inizio`}>
      <span class="display whitespace-nowrap text-2xl leading-none md:text-[1.7rem]">{name}</span>
      <span class="label hidden whitespace-nowrap text-white/60 2xl:inline">— {role}</span>
    </a>

    <nav class="hidden md:block" aria-label="Sezioni">
      <ul class="flex items-center gap-5 lg:gap-7">
        {
          items.map((item, i) => (
            <li>
              <a href={item.href} class="label link-line group inline-flex gap-1.5 whitespace-nowrap pb-0.5">
                <span class="text-white/45">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden text-white/70 xl:block">
      <Clock client:idle timezone={timezone} city={city} />
    </div>
    <MobileMenu client:load items={items} email={email} />
  </div>
</header>
